# ==============================================================================
# AI SQL Assistant - Environment Configuration
# ==============================================================================

# Database Configuration
# Default (SQLite zero-setup demo):
DATABASE_URL=sqlite:///data/ecommerce_demo.db

# Or PostgreSQL (e.g. from docker-compose):
# DATABASE_URL=postgresql://postgres:password123@localhost:5432/ecommerce

# LLM Provider Configuration
# Options: "mock" (offline/zero setup), "gemini", "openai", "ollama"
LLM_PROVIDER=mock

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (Local Models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Safety Guardrails
MAX_QUERY_ROWS_LIMIT=100
QUERY_TIMEOUT_SECONDS=10

